# AgentFlow Cloud Environment Variables

# LLM Inference
GROQ_API_KEY=your_groq_api_key_here
LLM_PROVIDER=groq

# Database (PostgreSQL)
POSTGRES_USER=agentflow
POSTGRES_PASSWORD=password
POSTGRES_DB=agentflow
POSTGRES_SERVER=localhost
POSTGRES_PORT=5433

# Weather API
OPENWEATHER_API_KEY=

# Chroma Vector Database (Optional - defaults to embedded persistent client)
CHROMA_HOST=localhost
CHROMA_PORT=8000

# S3 Cold Storage Lake (Optional - defaults to local lake mirror)
S3_BUCKET_NAME=agentflow-cold-lake
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
